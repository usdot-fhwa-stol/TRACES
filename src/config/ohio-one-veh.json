{
  "file_ext": "csv", 
  "class": "data_import.csv_process.CsvProcess", 
  "col_defs": 
  {
    "event_id": {"func": "group", "parms": [37, 38, 41]},
    "veh_id": {"src_col": 0, "type": "int"},
    "veh_time": {"src_col": 1},
    "lane_id": {"src_col": 33, "type": "int"},
    "orig_lane_id": {"src_col": 33, "type": "int"},
    "x_map_loc": {"src_col": 5},
    "y_map_loc": {"src_col": 6},
    "x_frenet_loc": {"src_col": 3},
    "y_frenet_loc": {"src_col": 4},
    "x_map_origin": {"src_col": 25},
    "y_map_origin": {"src_col": 26},
    "veh_lat": {"func": "utm_lat", "parms": [25, 26, 5, 6]},
    "veh_lon": {"func": "utm_lon", "parms": [25, 26, 5, 6]},
    "veh_speed": {"src_col": 11},
    "veh_accel": {"src_col": 12},
    "veh_length": {"src_col": 8},
    "veh_width": {"src_col": 9},
    "veh_automation": {"type": "int", "parms": ["1"]},
    "veh_dist_trav": {"src_col": 3},
    "event_name": {"func": "event_name", "parms": [42, 43, "OD: "]}
  }
}